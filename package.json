{
  "name": "rollbook",
  "version": "1.0.0",
  "private": true,
  "description": "QR 출석부 — Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rollbook-db",
    "db:migrate:local": "wrangler d1 migrations apply rollbook-db --local",
    "db:migrate": "wrangler d1 migrations apply rollbook-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
